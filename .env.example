# Copia este archivo a ".env" y completa los valores. ".env" NO se sube a git.

# --- Django ---
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos ---
# DB_ENGINE=sqlite  -> usa db.sqlite3 (desarrollo rapido, sin MySQL)
# DB_ENGINE=mysql   -> usa MySQL con los datos de abajo
DB_ENGINE=mysql
DB_NAME=ranfit
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# --- Correo (Mailtrap u otro SMTP para el EMAIL_* de Django) ---
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Gmail usado por send_email_* (authenticator/page/sales) ---
# OJO: el codigo actual lee estas dos con los nombres USER y PASS.
USER=
PASS=
